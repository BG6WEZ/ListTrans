+    monkeypatch.setenv(ce.SWITCH, "on")
+    result = matcher.match_item({"name": "查询", "unit": "个", "parsed_spec": {}}, initial_match_groups={})
+    assert [c["code"] for c in result["top_candidates"]] == ["B", "A", "C"]
