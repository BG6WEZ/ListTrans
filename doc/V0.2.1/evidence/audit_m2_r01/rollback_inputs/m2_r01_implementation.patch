+def test_priority_concurrent_edit_or_rematch_conflicts(api):
+    upload, post, _, _ = api
+    row, = upload("M2-CLEAN")
+    entry = prepared(post, row)
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        batch = pool.submit(submit, post, entry)
