+}
+
+.initial-overview button:focus-visible,
+#clear-initial-filter:focus-visible {
+    outline: 2px solid var(--color-primary);
+    outline-offset: 2px;
+}
+
+.initial-subfilters {
+    margin-top: 5px;
+}
+
+.initial-source-counts {
+    margin: 4px 0 0;
+    color: var(--color-text-secondary);
+    font-size: 11px;
+}
+
+#clear-initial-filter {
+    padding: 2px 4px;
+    border: 0;
+    background: transparent;
+    text-decoration: underline;
+}
+
+#items-table {
+    table-layout: fixed;
+}
+
+#items-table th,
+#items-table td {
+    padding-inline: 6px;
+    overflow-wrap: anywhere;
+}
+
+#items-table .workbench-row-number {
+    width: 42px;
+}
+
+.workbench-row-spec,
+.workbench-row-note {
+    color: var(--color-text-secondary);
+    font-size: 11px;
+}
+
+.workbench-row-spec {
+    display: -webkit-box;
+    -webkit-line-clamp: 2;
+    -webkit-box-orient: vertical;
+    overflow: hidden;
+}
+
+.current-row-result .row-status-pill {
+    margin-top: 2px;
+    white-space: normal;
+}
+
+.workbench-comparison {
+    display: grid;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 10px;
+    margin-block: 7px;
+}
+
+.workbench-comparison > div,
+.workbench-empty-binding {
+    padding: 7px 8px;
+    border: 1px solid var(--border-color);
+    border-radius: var(--radius-sm);
+}
+
+.workbench-comparison h5,
+.workbench-comparison p {
+    margin: 0;
+    overflow-wrap: anywhere;
+}
+
+.workbench-comparison h5 {
+    margin-bottom: 2px;
+    color: var(--color-text-primary);
+    font-size: 12px;
+}
+
+.workbench-empty-binding {
+    grid-column: 1 / -1;
+    color: var(--color-text-secondary);
+    font-size: 12px;
+    text-align: center;
+}
+
+.candidate-reference {
+    cursor: default;
+}
+
+.workbench .pagination-toolbar .btn {
+    color: var(--color-text-primary);
+    background: var(--bg-surface-elevated);
+    border: 1px solid var(--border-color);
+}
+
+.workbench .pagination-toolbar .btn:disabled {
+    color: var(--color-text-muted);
+    opacity: 0.7;
+}
+
+@media (max-width: 1140px) {
+    .app-header {
+        display: grid;
+        grid-template-columns: minmax(0, 1fr) auto;
+        height: auto;
+        max-height: none;
+        padding-block: 8px;
+        row-gap: 6px;
+    }
+
+    .app-header .nav-links {
+        grid-row: 2;
+        grid-column: 1 / -1;
+        margin: 0;
+    }
+}
+
+@media (max-width: 820px) {
+    .app-header {
+        grid-template-columns: minmax(0, 1fr);
+    }
+
+    .app-header .nav-links,
+    .app-header .header-actions {
+        flex-wrap: wrap;
+    }
+
+    .app-header .header-actions {
+        margin: 0;
+    }
+
+    .workbench {
+        flex-direction: column;
+        overflow: auto;
+    }
+
+    .workbench .panel {
+        width: 100%;
+        min-width: 0;
+        height: auto;
+        flex: 0 0 auto;
+    }
+
+    .workbench .list-scroll {
+        max-height: 45vh;
+    }
+}
+
 .review-filters .filter-tab {
     white-space: nowrap;
 }
