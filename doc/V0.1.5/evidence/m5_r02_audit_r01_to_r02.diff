+    with pytest.raises(excel_boundary.ParseCancelledError):
+        excel_boundary.validate_excel_container(
+            str(xlsx_path),
+            frozenset({".xlsx"}),
+            budget=excel_boundary.get_default_budget(),
+            cancel_event=cancel,
+        )
