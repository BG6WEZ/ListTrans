+def _dyn_scope_matches(scope_tgt: str, candidate_names: List[Any]) -> bool:
+    if not scope_tgt:
+        return True
+    targets = [t.strip().lower() for t in re.split(r'[/,，、|\s]+', scope_tgt) if t.strip()]
+    for c in candidate_names:
+        if not c:
+            continue
+        c_low = str(c).lower()
+        if any(t in c_low or c_low in t for t in targets):
+            return True
+    return False
+
