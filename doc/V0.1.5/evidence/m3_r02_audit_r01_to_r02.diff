+def _dyn_rule_matches_query(rule: Dict[str, Any], query_info: Dict[str, Any]) -> bool:
+    scope_lvl = rule.get("scope_level", "category")
+    scope_tgt = rule.get("scope_target", "")
+    if scope_lvl == "universal" or not scope_tgt:
+        return True
+    q_prof = str(query_info.get("professional", "") or query_info.get("original_category", "") or "").strip()
+    if q_prof:
+        q_prof = re.sub(r'^\d+[\.．\s]*', '', q_prof).strip()
+    prof_candidates = [
+        query_info.get("category", ""),
+        query_info.get("original_category", ""),
+        q_prof,
+        normalize_professional_category(q_prof) if q_prof else "",
+        query_info.get("domain", ""),
+        query_info.get("discipline", ""),
+        "给排水",
+        "通用",
+    ]
+    name_candidates = [
+        query_info.get("name", ""),
+        query_info.get("raw_name", ""),
+        query_info.get("original_name", ""),
+    ]
+    if scope_lvl == "discipline":
+        return _dyn_scope_matches(scope_tgt, prof_candidates)
+    if scope_lvl == "category":
+        return _dyn_scope_matches(scope_tgt, name_candidates)
+    return _dyn_scope_matches(scope_tgt, name_candidates + prof_candidates)
+
+
+def _dyn_candidate_text(candidate: Dict[str, Any], c_name: str = "", c_full_spec: str = "") -> str:
+    name_part = c_name or str(candidate.get("name", "") or "")
+    spec_part = c_full_spec or f"{candidate.get('specification', '') or ''} {candidate.get('description', '') or ''}".strip()
+    raw_name = str(candidate.get("name", "") or "")
+    parts = [raw_name]
+    if name_part and name_part != raw_name:
+        parts.append(name_part)
+    parts.append(spec_part)
+    parts.append(str(candidate.get("category", "") or ""))
+    parts.append(str(candidate.get("code", "") or ""))
+    return " ".join(parts)
