+def _to_strict_positive_float(value: Any) -> Optional[float]:
+    """仅接受严格有限正数值（拒绝 bool/字符串/集合/NaN/<=0）。"""
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        return None
+    f = float(value)
+    if not math.isfinite(f) or f <= 0:
+        return None
+    return f
+
