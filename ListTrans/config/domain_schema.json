{
    "schema_version": 2,
    "fan": {
        "must": [
            {
                "key": "风量",
                "type": "float",
                "unit": "m³/h",
                "extract_regex": "(?:风量|处理风量|循环风量)[:：]?\\s*([\\d\\.~\\\\-—及或到≥≤<>左右约]+(?:m³/h|m3/h|CMH|l/s|CFM)?)"
            },
            {
                "key": "机外余压",
                "type": "float",
                "unit": "Pa",
                "extract_regex": "(?:(?:机外余压|余压|静压|风压)[:：]?\\s*)?([\\d\\.~\\-—及或到≥≤<>左右约]+\\s*(?:Pa|kPa|MPa|mmH2O))"
            },
            {
                "key": "机型",
                "type": "enum",
                "options": [
                    "轴流",
                    "离心",
                    "管道",
                    "斜流",
                    "混流"
                ]
            },
            {
                "key": "材质",
                "type": "enum",
                "options": [
                    "镀锌钢板",
                    "不锈钢",
                    "玻璃钢",
                    "铝合金",
                    "PP"
                ]
            }
        ],
        "should": [
            {
                "key": "功率",
                "type": "float",
                "unit": "kW",
                "extract_regex": "(?:功率|电机功率|风机功率)[:：]?\\s*([\\d\\.~\\\\-—≥≤<>左右约]+(?:kW|W|HP)?)"
            },
            {
                "key": "转速",
                "type": "float",
                "unit": "rpm",
                "extract_regex": "(?:转速|r/min)[:：]?\\s*(\\d+(?:\\.\\d+)?)\\s*(?:rpm|r/min)?"
            },
            {
                "key": "噪音",
                "type": "float",
                "unit": "dB",
                "extract_regex": "(?:噪音|噪声)[:：]?\\s*(\\d+(?:\\.\\d+)?)\\s*(?:dB|db)?"
            },
            {
                "key": "口径",
                "type": "float",
                "unit": "mm",
                "extract_regex": "(?:口径|直通|直径)[:：]?\\s*(\\d+(?:\\.\\d+)?)\\s*mm"
            }
        ],
        "flags": [
            "防爆",
            "防腐",
            "变频",
            "静音",
            "耐高温"
        ],
        "weights": {
            "风量": 0.25,
            "机外余压": 0.2,
            "机型": 0.15,
            "材质": 0.1,
            "功率": 0.1,
            "flags": 0.2
        },
        "unit_class": "quantity",
        "hard_gates": {
            "conflict_caps": {
                "机型": 30
            },
            "deviation_caps": {
                "风量": {
                    "ratio": 0.5,
                    "abs_diff_standard": 500,
                    "abs_diff_small": 200,
                    "small_threshold": 500,
                    "cap": 30
                },
                "机外余压": {
                    "ratio": 0.5,
                    "abs_diff_standard": 200,
                    "cap": 30
                }
            }
        }
    },
    "damper": {
