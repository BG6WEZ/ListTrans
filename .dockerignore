# Deny the workspace by default. Only Docker inputs are admitted below.
**
!Dockerfile
!.dockerignore
!requirements.txt
!app/
app/**
!app/*.py
!web/
web/**
!web/index.html
!web/admin.html
!web/app.js
!web/index.css
!web/logo500.png
!web/logo.png
!web/login.html
!web/login.css
!config/
config/**

# VCS, IDE & Local Artifacts
.git
.gitignore
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.vscode
.idea
*.bak
*.old
*.orig
python_local/
venv/
.venv/

int_out.txt
reg_out.txt

# Environment & Secrets (NEVER enter Docker build context or layers)
.env
.env.*
**/.env*
*.pem
*.key
*.pfx
*.p12
*.crt
*.jks
*secret*
**/*secret*
*password*
**/*password*
*credential*
**/*credential*

# Databases, Runtime State, CSV Data & Backups (mounted externally at runtime)
*.db
*.db-wal
*.db-shm
*.db-journal
*.db.*
**/*.db
**/*.db.*
*.sqlite
*.sqlite3
*.backup
**/*.backup
*backup*
**/*backup*
app/*.db
app/*.db-*
app/*.db.*
app/feedback_*.json
app/binding_feedback.json
app/uploads/
app/vector_cache/
app/__pycache__/
data/
**/data/
*.csv
**/*.csv
logs/

# Personnel, Snapshots, Docs, Scripts & Dev/Test Directories
model_offline/
doc/
scripts/
scratch/
.local-archive/
.screenshots/
.gemini/
.agents/
tests/
*.tar
*.tar.gz
*.zip
*.xls
*.xlsx
*cloud_users_snapshot*
golden_last_run/

# Config allowlist: deny non-baseline files (e.g. config/runtime_credentials.json) and permit ONLY the 16 baseline configs
config/*
!config/alias_dict.json
!config/auto_binding_rules.json
!config/boost_rules.json
!config/category_domain_map.json
!config/connection_dict.json
!config/domain_schema.json
!config/flags_dict.json
!config/llm_config.json
!config/llm_prompts.json
!config/material_dict.json
!config/model_config.json
!config/stop_words.json
!config/tolerance_rules.json
!config/unit_norm.json
!config/unit_rules.json
!config/weight_rules.json

# Final fail-safe exclusions after config allowlist
config/*credential*
config/*secret*
config/*password*
config/*backup*
config/*.db*
config/.env*

# Runtime-only synthetic assets. Keep every other file in this directory out.
!app/eval_assets/
app/eval_assets/**
!app/eval_assets/golden_runtime_v1.json
!app/eval_assets/report_template_v1.json
!app/eval_assets/smoke_materials_v1.json
