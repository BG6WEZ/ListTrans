# JWT Authentication Configuration
# Generate a strong unique random key before startup: openssl rand -hex 32
SECRET_KEY=<REPLACE_WITH_OPENSSL_RAND_HEX_32>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Initial System Administrator (Production startup fails if omitted or weak when auth.db has no admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<REPLACE_WITH_STRONG_INITIAL_ADMIN_PASSWORD>

# Security and CORS (set specific allowed origins in production)
ENABLE_DOCS=false
ALLOWED_ORIGINS=https://your-domain.example.com

# Deployment Automation (required only when running scripts/deploy_*.py or check/probe scripts)
DEPLOY_HOST=<REPLACE_WITH_TARGET_HOST>
DEPLOY_PORT=22
DEPLOY_USER=<REPLACE_WITH_SSH_USER>
DEPLOY_SSH_KEY_PATH=<REPLACE_WITH_PRIVATE_KEY_PATH>
DEPLOY_REMOTE_DIR=/home/huakang/ListTrans

# LLM Integration (optional)
LLM_ENABLED=false
DASHSCOPE_API_KEY=<REPLACE_WITH_DASHSCOPE_KEY_IF_ENABLED>

